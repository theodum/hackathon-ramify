# ================================================
# GREENPULSE — Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs
# ================================================

# ─────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# ─────────────────────────────────────────
# BASE DE DONNÉES PostgreSQL
# ─────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=greenpulse
POSTGRES_USER=greenpulse
POSTGRES_PASSWORD=greenpulse123
DATABASE_URL=postgresql://greenpulse:greenpulse123@localhost:5432/greenpulse

# ─────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────
# AUTHENTIFICATION JWT
# ─────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_minimum_32_chars
JWT_EXPIRY=7d
JWT_REFRESH_SECRET=your_refresh_secret_also_change_this
JWT_REFRESH_EXPIRY=30d

# ─────────────────────────────────────────
# ANTHROPIC (Claude) — Moteur IA
# ─────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=4096

# ─────────────────────────────────────────
# MONITORING
# ─────────────────────────────────────────
PROMETHEUS_METRICS_PORT=9091
GRAFANA_PASSWORD=admin

# ─────────────────────────────────────────
# SCANNERS
# ─────────────────────────────────────────
MAX_CONCURRENT_SCANS=3
SCAN_TIMEOUT_MS=120000
LIGHTHOUSE_CHROME_FLAGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=false

# ─────────────────────────────────────────
# RAPPORTS PDF
# ─────────────────────────────────────────
REPORT_STORAGE_PATH=/tmp/reports
REPORT_RETENTION_DAYS=90

# ─────────────────────────────────────────
# SÉCURITÉ
# ─────────────────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
BCRYPT_SALT_ROUNDS=12

# ─────────────────────────────────────────
# EMAIL (optionnel - alertes)
# ─────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@greenpulse.io
SMTP_PASS=your_smtp_password
SMTP_FROM=GreenPulse <noreply@greenpulse.io>
