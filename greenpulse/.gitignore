# =============================================================================
# GreenPulse — Monorepo .gitignore
# =============================================================================

# ── Node.js ──────────────────────────────────────────────────────────────────
node_modules/
.npm
.yarn-integrity

# ── Build outputs ─────────────────────────────────────────────────────────────
dist/
build/
.next/
.nuxt/
out/

# ── Environment variables ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
# Keep the example file
!.env.example

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
*.log.*
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Database backups ──────────────────────────────────────────────────────────
backups/
*.sql.gz
*.dump

# ── Generated reports (PDFs) ─────────────────────────────────────────────────
reports/
*.pdf
# Keep backend source reports module
!apps/backend/src/reports/

# ── Test coverage ─────────────────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov

# ── OS / Editor ───────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# JetBrains IDEs
.idea/
*.iml
*.iws

# VSCode (keep .vscode/extensions.json and .vscode/settings.json if desired)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# ── TypeScript ────────────────────────────────────────────────────────────────
*.tsbuildinfo
tsconfig.tsbuildinfo

# ── Docker volumes (local mounts) ────────────────────────────────────────────
postgres-data/
redis-data/
prometheus-data/
grafana-data/

# ── Puppeteer / Chromium ─────────────────────────────────────────────────────
.local-chromium/
.chromium/

# ── Misc ─────────────────────────────────────────────────────────────────────
*.swp
*.swo
*.tmp
*.temp
.cache/
.parcel-cache/
.turbo/
